{
  "name": "tastechef",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:mobile": "pnpm --filter @tastechef/mobile dev",
    "build:mobile": "pnpm --filter @tastechef/mobile build",
    "android:sync": "pnpm --filter @tastechef/mobile cap:sync",
    "apk": "pnpm --filter @tastechef/mobile android:apk"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
