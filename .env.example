# -------------------------------------------------------------
# Supabase (Postgres, pgvector, Supabase Auth)
# -------------------------------------------------------------
# The Android app and @tastechef/distilled-ai need NONE of these.
# With no ANTHROPIC_API_KEY the API automatically serves the
# offline distilled chef instead of calling an LLM.
# -------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# -------------------------------------------------------------
# LLM Provider (Anthropic Claude - swappable)
# -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...
LLM_MAX_TOKENS=4096

# -------------------------------------------------------------
# Embeddings Provider (OpenAI text-embedding-3-small - swappable)
# -------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...

# -------------------------------------------------------------
# Nutrition Database (USDA FoodData Central API)
# -------------------------------------------------------------
USDA_API_KEY=DEMO_KEY

# -------------------------------------------------------------
# API Server Configuration
# -------------------------------------------------------------
API_PORT=3001
API_BASE_URL=http://localhost:3001
RATE_LIMIT_REQUESTS_PER_MINUTE=30

# -------------------------------------------------------------
# Next.js Client Configuration (prefixed with NEXT_PUBLIC_)
# -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
